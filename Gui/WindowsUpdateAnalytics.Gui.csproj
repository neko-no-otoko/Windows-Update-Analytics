<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WindowsUpdateAnalytics</RootNamespace>
    <AssemblyName>WindowsUpdateAnalytics</AssemblyName>
    <Version>2.2.1</Version>
    <FileVersion>2.2.1.0</FileVersion>
    <AssemblyVersion>2.2.1.0</AssemblyVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WindowsUpdateAnalytics.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Assets\**\*" LogicalName="Payload/Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Data\**\*" LogicalName="Payload/Data/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\docs\**\*" LogicalName="Payload/docs/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Modules\**\*" LogicalName="Payload/Modules/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Tests\**\*" LogicalName="Payload/Tests/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\BundleManifest.sha256" LogicalName="Payload/BundleManifest.sha256" />
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="Payload/CHANGELOG.md" />
    <EmbeddedResource Include="..\Invoke-Win11UpgradeDiag.ps1" LogicalName="Payload/Invoke-Win11UpgradeDiag.ps1" />
    <EmbeddedResource Include="..\NOTICE.md" LogicalName="Payload/NOTICE.md" />
    <EmbeddedResource Include="..\Prepare-Win11UpgradeDiag.cmd" LogicalName="Payload/Prepare-Win11UpgradeDiag.cmd" />
    <EmbeddedResource Include="..\README.md" LogicalName="Payload/README.md" />
    <EmbeddedResource Include="..\Start-Win11UpgradeDiag.cmd" LogicalName="Payload/Start-Win11UpgradeDiag.cmd" />
    <EmbeddedResource Include="..\VERSION" LogicalName="Payload/VERSION" />
    <EmbeddedResource Include="..\Watch-Win11Upgrade.ps1" LogicalName="Payload/Watch-Win11Upgrade.ps1" />
  </ItemGroup>
</Project>
